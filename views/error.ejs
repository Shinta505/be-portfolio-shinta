<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Terjadi Kesalahan - Portfolio & CMS API</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>

<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between selection:bg-indigo-600 selection:text-white">

    <!-- Container Utama -->
    <div class="max-w-md mx-auto w-full px-4 py-20 flex-grow flex flex-col items-center justify-center text-center">

        <!-- Ilustrasi / Badge Status Error -->
        <div class="inline-flex items-center justify-center w-20 h-20 bg-rose-50 border border-rose-100 rounded-full mb-6 shadow-sm">
            <svg class="w-10 h-10 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
        </div>

        <!-- Kode Status & Pesan -->
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 mb-2 tracking-tight">
            Oops!
        </h1>
        <p class="text-rose-600 font-semibold text-lg mb-4">
            Terjadi Kesalahan pada Server
        </p>

        <!-- Kotak Informasi Pesan Error -->
        <div class="w-full bg-white border border-slate-200 rounded-xl p-4 mb-8 shadow-sm text-left">
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Detail Pesan:</span>
            <p class="text-sm font-mono text-slate-600 bg-slate-50 p-3 rounded-lg border border-slate-100 break-words">
                <%= typeof message !== 'undefined' ? message : 'Sistem mengalami kendala tak terduga saat memproses permintaan Anda.' %>
            </p>
        </div>

        <!-- Tombol Navigasi Kembali -->
        <div class="flex flex-col sm:flex-row gap-3 w-full">
            <a href="/" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm py-3 px-4 rounded-xl transition duration-200 shadow-sm text-center">
                Kembali ke Beranda
            </a>
            <button onclick="window.location.reload()" class="flex-1 bg-white hover:bg-slate-50 text-slate-700 font-medium text-sm py-3 px-4 rounded-xl border border-slate-200 transition duration-200 shadow-sm text-center">
                Muat Ulang Halaman
            </button>
        </div>

    </div>

    <!-- Footer -->
    <footer class="max-w-4xl mx-auto w-full px-4 py-6 border-t border-slate-200 text-center text-xs text-slate-400">
        <p>&copy; 2026 Portfolio Backend System. Running on Supabase & Vercel.</p>
    </footer>

</body>

</html>