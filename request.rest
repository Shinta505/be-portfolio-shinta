@baseUrl = http://localhost:5000/api
@authToken = {{login.response.body.accessToken}}

### ==========================================
### 1. AUTHENTICATION API
### ==========================================

# @name login
POST {{baseUrl}}/login
Content-Type: application/json

{
    "username": "ShintaNursobah",
    "password": "ShintaLucu12"
}

### Get Current Admin Profile (Me)
GET {{baseUrl}}/me
Authorization: Bearer {{authToken}}

### Logout Admin
DELETE {{baseUrl}}/logout
Authorization: Bearer {{authToken}}


### ==========================================
### 2. PROFILE API
### ==========================================

### Get Public Profile
GET {{baseUrl}}/profile

### Update Profile (Admin Only)
PUT {{baseUrl}}/profile
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "fullname": "Shinta Nursobah Chairani",
    "headline": "Full-stack Web Developer & UI/UX Designer",
    "bio": "Deskripsi singkat mengenai latar belakang profesional dan keahlian Anda telah di update.",
    "profile_image": "/uploads/profile.jpg",
    "location": "Sleman, Yogyakarta",
    "email": "email@example.com",
    "github_url": "https://github.com/username",
    "linkedin_url": "https://linkedin.com/in/username",
    "instagram_url": "https://instagram.com/username",
    "tiktok_url": "",
    "twitter_url": ""
}


### ==========================================
### 3. PROJECT API (GALERI KARYA)
### ==========================================

### Get All Projects (Optional query: ?category=Website%20Development)
GET {{baseUrl}}/projects

### Get Project by UUID or Slug
GET {{baseUrl}}/projects/ce7fb94d-4d9a-4d6e-944c-44361cf81260

### Create New Project (Admin Only)
POST {{baseUrl}}/projects
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "title": "Portfolio Website CMS",
    "category": "Website Development",
    "description": "Sistem manajemen konten portofolio pribadi berbasis Node.js dan Supabase.",
    "tools": "Node.js, Express, Sequelize, Tailwind CSS, Supabase",
    "github_url": "https://github.com/username/project",
    "figma_url": "https://figma.com/file/xyz",
    "website_url": "https://example.com"
}

### Update Project by UUID (Admin Only)
PUT {{baseUrl}}/projects/ce7fb94d-4d9a-4d6e-944c-44361cf81260
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "title": "Portfolio Website CMS Updated",
    "category": "Website Development",
    "description": "Pembaruan deskripsi sistem manajemen konten portofolio.",
    "tools": "Node.js, Express, Sequelize, Supabase",
    "github_url": "https://github.com/username/project",
    "figma_url": null,
    "website_url": "https://example.com"
}

### Delete Project by UUID (Admin Only)
DELETE {{baseUrl}}/projects/ce7fb94d-4d9a-4d6e-944c-44361cf81260
Authorization: Bearer {{authToken}}


### ==========================================
### 4. ARTICLE API (BLOG & ARTIKEL)
### ==========================================

### Get All Articles (Optional query: ?status=published)
GET {{baseUrl}}/articles

### Get Article by UUID or Slug
GET {{baseUrl}}/articles/cd629dc9-8f4d-4d9e-b0f0-9149993ddf83

### Create New Article (Admin Only)
POST {{baseUrl}}/articles
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "title": "Belajar Express JS dan Sequelize",
    "slug": "belajar-express-js-dan-sequelize",
    "content": "Konten lengkap artikel mengenai backend development...",
    "status": "published"
}

### Update Article by UUID (Admin Only)
PUT {{baseUrl}}/articles/cd629dc9-8f4d-4d9e-b0f0-9149993ddf83
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "title": "Belajar Express JS dan Sequelize Updated",
    "slug": "belajar-express-js-dan-sequelize-updated",
    "content": "Pembaruan isi konten artikel.",
    "status": "published"
}

### Delete Article by UUID (Admin Only)
DELETE {{baseUrl}}/articles/cd629dc9-8f4d-4d9e-b0f0-9149993ddf83
Authorization: Bearer {{authToken}}


### ==========================================
### 5. CONTACT API (FORMULIR KONTAK)
### ==========================================

### Send New Message (Public - Rate Limited)
POST {{baseUrl}}/contact
Content-Type: application/json

{
    "name": "Pengunjung",
    "email": "pengunjung@example.com",
    "message": "Halo, saya ingin mendiskusikan kolaborasi project."
}

### Get All Messages (Admin Only)
GET {{baseUrl}}/contacts
Authorization: Bearer {{authToken}}

### Get Message Detail by UUID (Admin Only)
GET {{baseUrl}}/contacts/cd89126a-583a-4e20-88aa-2a9de03adfbe
Authorization: Bearer {{authToken}}

### Delete Message by UUID (Admin Only)
DELETE {{baseUrl}}/contacts/cd89126a-583a-4e20-88aa-2a9de03adfbe
Authorization: Bearer {{authToken}}


### ==========================================
### 6. RESUME / CV API
### ==========================================

### Get All Resumes
GET {{baseUrl}}/resumes

### Get Active Resume for Public
GET {{baseUrl}}/resumes/active

### Create New Resume (Admin Only)
POST {{baseUrl}}/resumes
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "version_name": "Fullstack Developer v1",
    "cv_url": "https://example.com/cv.pdf",
    "is_active": true
}

### Update Resume by UUID (Admin Only)
PUT {{baseUrl}}/resumes/93e680f5-bd85-42f9-adae-55fa845c7bcf
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "version_name": "Fullstack Developer v2",
    "cv_url": "https://example.com/cv-v2.pdf",
    "is_active": true
}

### Set Resume as Active Main (Admin Only)
PATCH {{baseUrl}}/resumes/93e680f5-bd85-42f9-adae-55fa845c7bcf/active
Authorization: Bearer {{authToken}}

### Delete Resume by UUID (Admin Only)
DELETE {{baseUrl}}/resumes/93e680f5-bd85-42f9-adae-55fa845c7bcf
Authorization: Bearer {{authToken}}


